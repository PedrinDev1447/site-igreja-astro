---
import { SITE } from "../config/site";
---

<!-- Painel escuro único (direção L do Claude Design): mapa à esquerda, endereço e ações à direita.
     Mapa em tons escuros: o filtro (cinza + inversão) deixa o fundo preto e os rótulos claros.
     O iframe sobe 10rem além da área visível para esconder o cartão "Open in Maps" do Google.
     O mapa é fixo (sem arrastar) e o pin branco com brilho é desenhado por cima, na ponta exata
     do marcador do Google (centro do iframe = 50% - 5rem da altura visível). -->
<div
  class="bg-bg-charcoal text-text-light flex flex-wrap items-stretch overflow-hidden rounded-[20px] shadow-[0_24px_60px_rgba(0,0,0,0.25)]"
  data-reveal
>
  <div class="bg-bg-dark relative m-3 min-h-[320px] min-w-0 flex-[1_1_460px] overflow-hidden rounded-xl md:min-h-[360px]">
    <iframe
      title={`Mapa de localização — ${SITE.nome}`}
      src={SITE.mapsEmbedUrl}
      loading="lazy"
      tabindex="-1"
      referrerpolicy="no-referrer-when-downgrade"
      class="pointer-events-none absolute inset-x-0 -top-40 h-[calc(100%+10rem)] w-full border-0 [filter:grayscale(1)_invert(0.92)_contrast(0.95)_brightness(0.95)]"
    ></iframe>
    <svg
      viewBox="0 0 24 32"
      aria-hidden="true"
      class="pointer-events-none absolute top-[calc(50%-5rem)] left-1/2 h-16 w-12 -translate-x-1/2 -translate-y-full [filter:drop-shadow(0_0_5px_rgba(255,255,255,0.9))_drop-shadow(0_0_20px_rgba(255,255,255,0.55))]"
    >
      <path
        d="M12 0C5.4 0 0 5.2 0 11.7 0 20.4 12 32 12 32s12-11.6 12-20.3C24 5.2 18.6 0 12 0z"
        fill="#ffffff"
      ></path>
      <circle cx="12" cy="11.5" r="4.5" fill="#1a1a1a"></circle>
    </svg>
  </div>

  <div class="flex min-w-0 flex-[1_1_340px] flex-col items-center justify-center gap-5 p-6 text-center md:p-12">
    <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
      Venha nos visitar
    </p>
    <p class="font-display text-2xl leading-snug md:text-3xl">
      {SITE.endereco}
    </p>

    <div class="flex w-full max-w-[360px] items-center gap-3 pt-1">
      <a
        href={SITE.mapsDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-text-light text-text-dark flex h-14 min-w-0 flex-1 items-center justify-center rounded-full text-[17px] font-semibold transition duration-200 hover:scale-[1.02] hover:opacity-90"
      >
        Como chegar<span class="sr-only"> (abre em nova aba)</span>
      </a>
      <button
        type="button"
        data-copy-address={SITE.endereco}
        aria-label="Copiar endereço"
        title="Copiar endereço"
        class="inline-flex h-14 w-14 flex-none cursor-pointer items-center justify-center rounded-[14px] border border-white/40 transition duration-200 hover:border-white hover:bg-white/10"
      >
        <svg
          data-icon-copy
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
          <path d="M5.5 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v.5"></path>
        </svg>
        <svg
          data-icon-ok
          hidden
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12.5l4.5 4.5L19 7.5"></path>
        </svg>
      </button>
      <span class="sr-only" role="status" data-copy-status></span>
    </div>
  </div>
</div>
