---
import { SITE } from "../config/site";
---

<div
  class="border-text-muted/20 grid gap-0 overflow-hidden rounded-lg border md:grid-cols-2"
  data-reveal
>
  <!-- O iframe sobe 6rem além da área visível para esconder o cartão "Open in Maps" do Google. -->
  <div class="relative h-72 overflow-hidden md:h-auto md:min-h-[360px]">
    <iframe
      title={`Mapa de localização — ${SITE.nome}`}
      src={SITE.mapsEmbedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-x-0 -top-24 h-[calc(100%+6rem)] w-full border-0"
    ></iframe>
  </div>
  <div class="bg-bg-ivory-deep flex flex-col justify-center gap-5 p-6 md:p-10">
    <p class="font-serif text-xl leading-snug">{SITE.endereco}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={SITE.mapsDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-bg-dark text-text-light inline-flex h-12 items-center justify-center rounded-full px-6 font-semibold transition duration-200 hover:scale-[1.03] hover:opacity-90"
      >
        Como chegar<span class="sr-only"> (abre em nova aba)</span>
      </a>
      <button
        type="button"
        data-copy-address={SITE.endereco}
        class="border-text-dark/30 inline-flex h-12 min-w-52 items-center justify-center rounded-full border px-6 font-semibold transition duration-200 hover:bg-black/5"
      >
        Copiar endereço
      </button>
      <span class="sr-only" role="status" data-copy-status></span>
    </div>
  </div>
</div>
