---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  pastor: CollectionEntry<"pastores">["data"];
}

const { pastor } = Astro.props;
---

<!-- Retrato 4:5 com nome e função sobre a foto (degradê escuro).
     Pensado para fundo escuro: o texto usa branco com transparência. -->
<article class="group flex w-full flex-col gap-3.5">
  <div class="bg-bg-dark relative aspect-[4/5] overflow-hidden rounded-[14px]">
    <Image
      src={pastor.foto}
      alt={`${pastor.nome}, ${pastor.papel}`}
      width={520}
      height={650}
      sizes="(min-width: 1024px) 260px, (min-width: 768px) 30vw, 45vw"
      class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
    />
    <div class="from-bg-dark/90 absolute inset-x-0 bottom-0 bg-gradient-to-t to-transparent px-3.5 pt-10 pb-3.5">
      <h4 class="font-display text-xl leading-tight">{pastor.nome}</h4>
      <p class="mt-0.5 text-[13px] text-white/80">{pastor.papel}</p>
    </div>
  </div>
</article>
