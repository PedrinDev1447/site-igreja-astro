---
import PastorCard from "./PastorCard.astro";
import { getCollection } from "astro:content";

const todos = await getCollection("pastores");
// Pastor titular sempre primeiro dentro do seu grupo.
const titularPrimeiro = (a: { papel: string }, b: { papel: string }) =>
  Number(/titular/i.test(b.papel)) - Number(/titular/i.test(a.papel));
const pastores = todos
  .filter((p) => p.data.grupo === "pastor")
  .map((p) => p.data)
  .sort(titularPrimeiro);
const pastoras = todos
  .filter((p) => p.data.grupo === "pastora")
  .map((p) => p.data)
  .sort(titularPrimeiro);

// Todos os cartões têm o MESMO tamanho em qualquer tela (2, 3 ou 4 por linha); linha incompleta
// fica centralizada, sem esticar o cartão: largura = (100% - lacunas) / colunas, com gap de 1rem.
const grade = "flex flex-wrap justify-center gap-4";
const celula =
  "w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.667rem)] lg:w-[calc(25%-0.75rem)]";
const grupos = [
  { titulo: "Pastores", lista: pastores },
  { titulo: "Pastoras", lista: pastoras },
].filter((g) => g.lista.length > 0);
---

<section
  id="pastores"
  aria-labelledby="titulo-pastores"
  class="bg-bg-charcoal text-text-light"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <div class="mb-12 flex flex-col items-center gap-3 text-center md:mb-14">
      <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
        Liderança
      </p>
      <h2
        id="titulo-pastores"
        class="font-display text-3xl md:text-4xl titulo-sublinhado"
      >
        Os pastores
      </h2>
    </div>

    <div class="flex flex-col gap-12 md:gap-14">
      {grupos.map((grupo) => (
        <div class="flex flex-col gap-6">
          <h3 class="text-center text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
            {grupo.titulo}
          </h3>
          <div class={grade}>
            {grupo.lista.map((pastor, i) => (
              <div class={celula} data-reveal style={`--d:${i * 80}ms`}>
                <PastorCard pastor={pastor} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
