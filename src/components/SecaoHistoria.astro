---
import Timeline from "./Timeline.astro";
---

<section
  id="historia"
  aria-labelledby="titulo-historia"
  class="bg-bg-ivory-deep"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <h2
      id="titulo-historia"
      class="font-display mb-10 text-3xl md:text-4xl titulo-sublinhado"
    >
      Nossa história
    </h2>
    <Timeline />
  </div>
</section>
