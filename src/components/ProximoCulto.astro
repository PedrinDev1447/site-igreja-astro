---
import { getCollection } from "astro:content";
import { SITE } from "../config/site";

// Regra de recorrência de cada culto, pelo nome do dia em src/content/cultos/*.json.
// Se um culto novo for cadastrado, acrescente a regra aqui; sem regra ele só some do cálculo
// do "próximo culto" (a tabela de horários continua mostrando).
const REGRAS: Record<string, string> = {
  Domingo: "semanal:0",
  "Quarta-feira": "semanal:3",
  "Última sexta-feira do mês": "ultima-sexta",
};

function formatarHora(hhmm: string): string {
  const [h, m] = hhmm.split(":");
  const horaNum = Number.parseInt(h, 10);
  return m === "00" ? `${horaNum}h` : `${horaNum}h${m}`;
}

const cultos = (await getCollection("cultos"))
  .map((entry) => entry.data)
  .filter((c) => REGRAS[c.dia])
  .map((c) => ({
    dia: c.dia,
    regra: REGRAS[c.dia],
    inicio: c.horaInicio,
    fim: c.horaFim,
    inicioTexto: formatarHora(c.horaInicio),
  }));
---

<!-- Cartão escuro ao lado da tabela de horários. O bloco "Próximo culto" é preenchido no
     navegador (src/scripts/interacoes.ts); sem JS ele fica oculto e o resto continua útil. -->
<aside
  aria-label="Visite-nos"
  class="bg-bg-charcoal text-text-light flex flex-col gap-6 rounded-lg p-6 md:p-8"
  data-reveal
  data-proximo-culto={JSON.stringify(cultos)}
>
  <div hidden data-proximo-bloco>
    <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
      Próximo culto
    </p>
    <p
      class="font-serif mt-2 text-2xl leading-snug md:text-3xl"
      data-proximo-texto
      aria-live="polite"
    ></p>
    <p class="mt-1 text-sm text-white/70" data-proximo-detalhe></p>
  </div>

  <div class="border-t border-white/15 pt-6">
    <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
      Venha nos visitar
    </p>
    <p class="mt-2 text-lg leading-snug">{SITE.endereco}</p>
  </div>

  <a
    href="#localizacao"
    class="bg-text-light text-text-dark inline-flex h-12 w-fit items-center justify-center rounded-full px-8 font-semibold transition duration-200 hover:scale-[1.03] hover:opacity-90"
  >
    Ver como chegar
  </a>
</aside>
