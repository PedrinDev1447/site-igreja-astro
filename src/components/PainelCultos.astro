---
import { getCollection } from "astro:content";
import { SITE } from "../config/site";
import EventCalendar from "./EventCalendar.astro";

// Regra de recorrência de cada culto, pelo nome do dia em src/content/cultos/*.json.
// Se um culto novo for cadastrado, acrescente a regra aqui; sem regra ele só some do cálculo
// do "próximo culto" (a tabela de horários continua mostrando).
const REGRAS: Record<string, string> = {
  Domingo: "semanal:0",
  "Quarta-feira": "semanal:3",
  "Última sexta-feira do mês": "ultima-sexta",
};

function formatarHora(hhmm: string): string {
  const [h, m] = hhmm.split(":");
  const horaNum = Number.parseInt(h, 10);
  return m === "00" ? `${horaNum}h` : `${horaNum}h${m}`;
}

const cultos = (await getCollection("cultos"))
  .map((entry) => entry.data)
  .filter((c) => REGRAS[c.dia])
  .map((c) => ({
    dia: c.dia,
    regra: REGRAS[c.dia],
    inicio: c.horaInicio,
    fim: c.horaFim,
    inicioTexto: formatarHora(c.horaInicio),
  }));
---

<!-- Painel único: próximo culto, horários e endereço num bloco escuro. O "próximo culto" é
     calculado no navegador (src/scripts/interacoes.ts); sem JS esse espaço fica vazio e os
     horários e o endereço continuam completos. -->
<div
  class="bg-bg-charcoal text-text-light flex flex-col gap-8 rounded-[20px] p-6 shadow-[0_24px_60px_rgba(0,0,0,0.25)] md:p-12"
  data-reveal
  data-proximo-culto={JSON.stringify(cultos)}
>
  <div class="flex flex-wrap gap-x-14 gap-y-8">
    <div
      class="invisible flex min-w-0 flex-[1_1_320px] flex-col gap-2"
      aria-hidden="true"
      data-proximo-bloco
    >
      <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
        Próximo culto
      </p>
      <p
        class="font-display text-5xl leading-[1.05] lg:text-7xl"
        data-proximo-texto
        aria-live="polite"
      ></p>
      <p class="text-[15px] text-white/70" data-proximo-detalhe></p>
      <!-- Contagem regressiva até o início do próximo culto (ou até o fim, se já estiver
           acontecendo). Os números são decorativos para leitores de tela; o resumo em texto só muda
           a cada minuto (não anunciar a cada segundo). Preenchida por src/scripts/interacoes.ts. -->
      <div class="mt-5 flex flex-col gap-2" data-contagem>
        <p
          class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase"
          data-contagem-rotulo
        >
          Faltam
        </p>
        <div class="flex gap-2 sm:gap-3" aria-hidden="true">
          {[
            ["dias", "Dias"],
            ["horas", "Horas"],
            ["minutos", "Min"],
            ["segundos", "Seg"],
          ].map(([unidade, rotulo]) => (
            <div class="flex w-16 flex-col items-center rounded-xl border border-white/15 bg-white/5 px-3 py-2.5 sm:w-[4.75rem]">
              <span
                class="font-display text-2xl leading-none tabular-nums sm:text-3xl"
                data-contagem-valor={unidade}
              >
                0
              </span>
              <span class="mt-1.5 text-[11px] tracking-wider text-white/60 uppercase">
                {rotulo}
              </span>
            </div>
          ))}
        </div>
        <p class="sr-only" data-contagem-resumo></p>
      </div>
    </div>

    <div class="flex min-w-0 flex-[1_1_320px] flex-col">
      <h2
        id="titulo-cultos"
        class="mb-2 text-xs font-semibold tracking-[0.2em] text-white/70 uppercase"
      >
        Horários de culto
      </h2>
      <EventCalendar />
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-white/15 pt-7">
    <div class="flex flex-col gap-1">
      <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
        Venha nos visitar
      </p>
      <p class="text-[17px] leading-normal">{SITE.endereco}</p>
    </div>
    <a
      href="#localizacao"
      class="bg-text-light text-text-dark inline-flex h-12 items-center justify-center rounded-full px-7 font-semibold transition duration-200 hover:scale-[1.03] hover:opacity-90"
    >
      Ver como chegar
    </a>
  </div>
</div>
