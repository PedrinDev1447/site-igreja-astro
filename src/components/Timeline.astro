---
import { getCollection } from "astro:content";

// A ordem vem do nome do arquivo (01-, 02-...), porque `data` é texto livre ("Na pandemia", "Hoje").
const marcos = (await getCollection("historia"))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry) => entry.data);
---

<ol class="border-text-muted/20 flex max-w-2xl flex-col gap-8 border-l pl-6">
  {marcos.map((marco) => (
    <li class="relative">
      <span
        class="bg-text-muted absolute top-1.5 -left-[29.5px] size-2.5 rounded-full"
        aria-hidden="true"
      ></span>
      <p class="text-text-muted text-sm font-semibold">{marco.data}</p>
      <h3 class="font-display mt-0.5 text-lg">{marco.titulo}</h3>
      <p class="text-text-muted mt-1 leading-relaxed">{marco.descricao}</p>
    </li>
  ))}
</ol>
