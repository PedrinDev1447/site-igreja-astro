---
import { SITE } from "../config/site";
import LogoMark from "./LogoMark.astro";

const NAV_LINKS = [
  { label: "Cultos", href: "#cultos" },
  { label: "Quem somos", href: "#quem-somos" },
  { label: "Pastores", href: "#pastores" },
  { label: "História", href: "#historia" },
  { label: "Pregações", href: "#pregacao" },
  { label: "Como chegar", href: "#localizacao" },
];
---

<header class="bg-bg-charcoal/90 text-text-light sticky top-0 z-50 border-b border-white/10 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2 md:px-8">
    <a href="#inicio" class="flex min-h-11 items-center gap-3">
      <LogoMark class="h-9 w-9" />
      <span class="font-serif text-lg tracking-[0.08em] uppercase">
        {SITE.wordmark}
      </span>
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/20 lg:hidden"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Menu"
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="menu-open" d="M4 7h16M4 12h16M4 17h16" />
        <path class="menu-close hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <nav
      id="menu-principal"
      aria-label="Navegação principal"
      class="bg-bg-charcoal absolute inset-x-0 top-full hidden border-b border-white/10 px-4 pb-4 lg:static lg:block lg:border-0 lg:bg-transparent lg:p-0"
    >
      <ul class="flex flex-col text-base font-semibold lg:flex-row lg:gap-x-6 lg:text-sm">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="relative inline-flex min-h-12 w-full items-center py-2 text-white/80 transition-colors duration-200 hover:text-white aria-[current=location]:text-white lg:min-h-11 lg:w-auto lg:after:absolute lg:after:inset-x-0 lg:after:bottom-1 lg:after:h-px lg:after:origin-left lg:after:scale-x-0 lg:after:bg-white lg:after:transition-transform lg:after:duration-300 lg:hover:after:scale-x-100 lg:aria-[current=location]:after:scale-x-100"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
