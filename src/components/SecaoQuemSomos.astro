---
import { getCollection } from "astro:content";

// Textos em src/content/quem-somos/; a ordem vem do nome do arquivo (01-, 02-...).
// Sem `paragrafos`, o card mostra o aviso "Em breve" (e não abre). Com um parágrafo só, mostra o
// texto inteiro (e não abre). Com mais de um, mostra o início do texto (3 linhas); ao clicar, abre
// em tela cheia com o texto todo.
const itens = (await getCollection("quemSomos"))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry) => entry.data);
---

<section
  id="quem-somos"
  aria-labelledby="titulo-quem-somos"
  class="bg-bg-ivory-deep empilha tela"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <h2
      id="titulo-quem-somos"
      class="font-display mb-10 text-3xl md:text-4xl titulo-sublinhado"
    >
      Quem somos
    </h2>

    <div class="grid gap-6 lg:grid-cols-3">
      {itens.map((item, i) => (
        <div data-reveal style={`--d:${i * 100}ms`}>
          <article
            class="card-tela border-text-muted/20 flex h-full flex-col rounded-lg border bg-white/60 p-6"
            data-card-abrir={
              item.paragrafos && item.paragrafos.length > 1 ? "" : undefined
            }
          >
            <h3 class="font-display mb-3 text-xl">{item.titulo}</h3>
            {item.paragrafos && item.paragrafos.length > 1 ? (
              <>
                <p class="teaser text-text-muted mb-4 line-clamp-3">
                  {item.paragrafos[0]}
                </p>
                <button
                  type="button"
                  data-abrir
                  aria-haspopup="dialog"
                  class="mt-auto inline-flex min-h-11 cursor-pointer items-center gap-2 self-start text-sm font-semibold"
                >
                  Ler mais
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                </button>

                <dialog
                  class="tela-cheia"
                  data-tela-cheia
                  aria-labelledby={`tela-titulo-${i}`}
                >
                  <div class="tela-cheia__rolagem">
                    <div class="tela-cheia__conteudo">
                      <button
                        type="button"
                        data-fechar
                        aria-label="Fechar"
                        class="tela-cheia__fechar"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="24"
                          height="24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          aria-hidden="true"
                        >
                          <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                      </button>
                      <p class="text-text-muted text-xs font-semibold tracking-[0.2em] uppercase">
                        Quem somos
                      </p>
                      <h3
                        id={`tela-titulo-${i}`}
                        class="font-display text-5xl md:text-7xl"
                      >
                        {item.titulo}
                      </h3>
                      <div class="text-text-muted flex flex-col gap-5 text-lg leading-relaxed md:text-xl">
                        {item.paragrafos.map((p) => (
                          <p>{p}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                </dialog>
              </>
            ) : item.paragrafos ? (
              <p class="text-text-muted">{item.paragrafos[0]}</p>
            ) : (
              <p class="text-text-muted">Em breve: texto em preparação.</p>
            )}
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
