---
// TODO: textos reais de missão, visão e crenças ainda não enviados pelo dono do projeto.
// Por ora, Lorem ipsum como preenchimento (autorizado pelo dono); trocar `paragrafos` pelos
// textos reais. Sem `paragrafos`, o card mostra o aviso "Em breve" (e não abre).
// O card mostra só o início do texto (3 linhas); ao clicar, abre em tela cheia com o texto todo.
const itens: { titulo: string; paragrafos?: string[] }[] = [
  {
    titulo: "Missão",
    paragrafos: [
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
      "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
    ],
  },
  {
    titulo: "Visão",
    paragrafos: [
      "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
      "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.",
    ],
  },
  {
    titulo: "Crenças",
    paragrafos: [
      "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.",
      "Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.",
    ],
  },
];
---

<section
  id="quem-somos"
  aria-labelledby="titulo-quem-somos"
  class="bg-bg-ivory-deep empilha tela"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <h2
      id="titulo-quem-somos"
      class="font-display mb-10 text-3xl md:text-4xl titulo-sublinhado"
    >
      Quem somos
    </h2>

    <div class="grid items-start gap-6 md:grid-cols-3">
      {itens.map((item, i) => (
        <div data-reveal style={`--d:${i * 100}ms`}>
          <article
            class="card-tela border-text-muted/20 rounded-lg border bg-white/60 p-6"
            data-card-abrir={item.paragrafos ? "" : undefined}
          >
            <h3 class="font-display mb-3 text-xl">{item.titulo}</h3>
            {item.paragrafos ? (
              <>
                <p class="teaser text-text-muted line-clamp-3">
                  {item.paragrafos[0]}
                </p>
                <button
                  type="button"
                  data-abrir
                  aria-haspopup="dialog"
                  class="mt-4 inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm font-semibold"
                >
                  Ler mais
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                </button>

                <dialog
                  class="tela-cheia"
                  data-tela-cheia
                  aria-labelledby={`tela-titulo-${i}`}
                >
                  <div class="tela-cheia__rolagem">
                    <div class="tela-cheia__conteudo">
                      <button
                        type="button"
                        data-fechar
                        aria-label="Fechar"
                        class="tela-cheia__fechar"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="24"
                          height="24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          aria-hidden="true"
                        >
                          <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                      </button>
                      <p class="text-text-muted text-xs font-semibold tracking-[0.2em] uppercase">
                        Quem somos
                      </p>
                      <h3
                        id={`tela-titulo-${i}`}
                        class="font-display text-5xl md:text-7xl"
                      >
                        {item.titulo}
                      </h3>
                      <div class="text-text-muted flex flex-col gap-5 text-lg leading-relaxed md:text-xl">
                        {item.paragrafos.map((p) => (
                          <p>{p}</p>
                        ))}
                      </div>
                    </div>
                  </div>
                </dialog>
              </>
            ) : (
              <p class="text-text-muted">Em breve: texto em preparação.</p>
            )}
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
