---
import MapEmbed from "./MapEmbed.astro";
---

<section
  id="localizacao"
  aria-labelledby="titulo-localizacao"
  class="bg-bg-charcoal text-text-light border-t border-white/10"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <div class="mb-10 flex flex-col gap-3">
      <p class="text-xs font-semibold tracking-[0.2em] text-white/70 uppercase">
        Localização
      </p>
      <h2 id="titulo-localizacao" class="font-serif text-3xl md:text-4xl">
        Como chegar
      </h2>
    </div>
    <MapEmbed />
  </div>
</section>
